{
  "name": "vinyl-shelf",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D record shelf over your music folder. Pull out an album and it plays on a vinyl player.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Van De Weerd",
  "homepage": "https://gitguy268.github.io/vinyl-shelf/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitguy268/vinyl-shelf.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5291 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4291 --strictPort",
    "start": "npm run build && vite preview --port 4291 --strictPort --open",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && node scripts/notice.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "idb": "8.0.4",
    "music-metadata": "12.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
